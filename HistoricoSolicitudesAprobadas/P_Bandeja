      - Tmr_ConsultaSQL:
          Control: Timer@2.1.0
          Properties:
            AutoPause: =varPausarTimer
            AutoStart: =varIniciarTimer
            Duration: =5000
            OnTimerEnd: |-
              =//Refrescar Lista
              Refresh(Var_upc_HistoricoSolicitudesAlumno);
              //Registro de lista histórico
              Set(
                  varRegistroSharepoint,
                  LookUp(
                      Var_upc_HistoricoSolicitudesAlumno,
                      codigoUsuario = varCodigoUsuario
                  )
              );
              //Revisar la flag de Consulta
              If(
                  //Flag Si
                  varRegistroSharepoint.flagConsulta = varTablaJSONConfiguraciones.varFlagSi,
                  Set(
                      varIniciarTimer,
                      true
                  );
                  Set(
                      varPausarTimer,
                      false
                  );
                  Set(
                      varReiniciarTimer,
                      true
                  ),
                  //Flag No
                  varRegistroSharepoint.flagConsulta = varTablaJSONConfiguraciones.varFlagNo,
                  Set(
                      varIniciarTimer,
                      false
                  );
                  Set(
                      varPausarTimer,
                      true
                  );
                  Set(
                      varReiniciarTimer,
                      false
                  );
                  //Revisar estado de consulta
                  If(
                      //Estado Vacio
                      varRegistroSharepoint.estadoConsulta = varTablaJSONConfiguraciones.varEstadoVacio,
                      //Modal Error
                      Set(
                          varModalErrorVisible,
                          true
                      );
                      Set(
                          varModalErrorTexto,
                          varTablaJSONGlosas.varGlosaVacioConsultaSQL
                      ),
                      //Estado Error
                      varRegistroSharepoint.estadoConsulta = varTablaJSONConfiguraciones.varEstadoError,
                      //Modal Error
                      Set(
                          varModalErrorVisible,
                          true
                      );
                      Set(
                          varModalErrorTexto,
                          varTablaJSONGlosas.varGlosaErrorConsultaSQL
                      ),
                      //Estado Correcto
                      Set(
                          varModalErrorVisible,
                          false
                      );
                      ClearCollect(
                          colSolicitudesHistoricas,
                          AddColumns(
                              ForAll(
                                  ParseJSON(
                                      LookUp(
                                          Var_upc_HistoricoSolicitudesAlumno,
                                          codigoUsuario = varCodigoUsuario,
                                          jsonConsulta
                                      )
                                  ) As JsonTabla,
                                  {
                                      codigoSolicitud:           Text(JsonTabla.codigoSolicitud),
                                      nombreTramite:             Text(JsonTabla.nombreTramite),
                                      codigoTramiteText:         Text(JsonTabla.codigoTramiteText),
                                      codigoUsuario:             Text(JsonTabla.codigoUsuario),
                                      nombreAlumno:              Text(JsonTabla.nombreAlumno),
                                      nombreModalidad:           Text(JsonTabla.nombreModalidad),
                                      nivelAlumno:               Text(JsonTabla.nivelAlumno),
                                      codigoPeriodo:             Text(JsonTabla.codigoPeriodo),
                                      fechaSolicitud:            DateTimeValue(JsonTabla.fechaSolicitud),
                                      estadoSolicitud:           Text(JsonTabla.estadoSolicitud),
                                      estadoActividad:           Text(JsonTabla.estadoActividad),
                                      Rol:                       Text(JsonTabla.Rol),
                                      ID:                        Value(JsonTabla.Id),
                                      codigoConfiguracionTramiteKey: Value(JsonTabla.codigoConfiguracionTramite),
                                      fechaInicioSolicitud:      DateTimeValue(JsonTabla.fechaInicioSolicitud),
                                      fechaAtencionSolicitud:    DateTimeValue(JsonTabla.fechaAtencionSolicitud),
                                      fechaFinSolicitud:         DateTimeValue(JsonTabla.fechaFinSolicitud),
                                      counterSolicitud:          Text(JsonTabla.counterSolicitud),
                                      codigoActividadKey:        Value(JsonTabla.codigoActividad),
                                      asignadoA:                 Text(JsonTabla.asignadoA)
                                  }
                              ),
                              // Los LookUp se resuelven UNA sola vez sobre la tabla ya construida
                              'codigoConfiguracionTramite: duracion',
