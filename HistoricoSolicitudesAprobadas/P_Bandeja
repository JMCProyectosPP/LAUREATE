                  - NextArrow4:
                      Control: Classic/Icon@2.5.0
                      Properties:
                        AccessibleLabel: =Self.Tooltip
                        Color: =RGBA(0, 0, 0, 1)
                        Height: =60
                        Icon: =Icon.View
                        OnSelect: "=//Valicacion Actualizacion\nSet(\n    varSolicitud,\n    LookUp(\n        Var_upc_Solicitud,\n        ID = ThisItem.ID\n    )\n);\n// Validación de datos por trámite\nIf( // Validación ACTUALIZACIÓN DE DATOS\n    ThisItem.codigoSolicitud = \"ACTD\",\n    Refresh(Var_upc_DatosAlumno);\n    Set(\n        TramiteActualizacionSelected,\n        LookUp(\n            Var_upc_DatosAlumno,\n            idSolicitud = Value(ThisItem.ID)\n        )\n    );\n    Set(\n        varModalDetallesActualizacion,\n        true\n    );\n    Set(varTieneComentariosEvaluador, If(!IsBlank(TramiteActualizacionSelected.comentariosEvaluador), true, false));\n    Set(\n        varNombreChangeFont,\n        TramiteActualizacionSelected.flagActualizarNombre\n    );\n    Set(\n        varApellidoPaternoChangeFont,\n        TramiteActualizacionSelected.flagActualizarApellidoPaterno\n    );\n    Set(\n        varApellidoMaternoChangeFont,\n        TramiteActualizacionSelected.flagActualizarApellidoMaterno\n    );\n    Set(\n        varGeneroChangeFont,\n        TramiteActualizacionSelected.flagActualizarGenero\n    );\n    Set(\n        varNacionalidadChangeFont,\n        TramiteActualizacionSelected.flagActualizarNacionalidad\n    );\n    Set(\n        varTipoDocChangeFont,\n        TramiteActualizacionSelected.flagActualizarTipoDocumento\n    );\n    Set(\n        varNumeroDocChangeFont,\n        TramiteActualizacionSelected.flagActualizarNumeroDocumento\n    );\n    Set(\n        varFechaNacimientoChangeFont,\n        TramiteActualizacionSelected.flagActualizarFechaNacimiento\n    ),\n    // Validación CONSTANCIA MATRÍCULAS\n    ThisItem.codigoSolicitud = \"CONSTMAT\",\n    Refresh(var_upc_ConstanciaMatricula);\n    Set(\n        TramiteConstanciaMatriculaSelected,\n        LookUp(\n            var_upc_ConstanciaMatricula,\n            idSolicitud = Value(ThisItem.ID)\n        )\n    );\n    If( //Si está pagada la solicitud y sin observaciones\n        TramiteConstanciaMatriculaSelected.EstadoDocumento = \"ENTREGADO\" &&\n        IsBlank(TramiteConstanciaMatriculaSelected.observacionesProceso)\n        ,// muestra botón, oculta texto\n        Set(varEnableBotonDescargaCM, \"true\");\n        Set(varEnableResultadoErrorCM, \"false\")\n        ,\n        If( // Cualquier otro estado de solicitud, y tiene observaciones\n            !IsBlank(TramiteConstanciaMatriculaSelected.observacionesProceso)\n            , // oculta botón, muestra observaciones\n            Set(varEnableBotonDescargaCM, \"false\");\n            Set(varEnableResultadoErrorCM, \"true\")\n            , // oculta ambos\n            Set(varEnableBotonDescargaCM, \"false\");\n            Set(varEnableResultadoErrorCM, \"false\")\n        )\n    );\n    Set(\n        varModalDetallesConstanciaMatricula,\n        true\n    ),\n    // Validación CONSTANCIA DE ORDEN DE MÉRITO\n    ThisItem.codigoSolicitud = \"CONSTOME\",\n    Refresh(Var_upc_ConstanciaOrdenMerito);\n    Set(\n        TramiteConstanciaOrdenMeritoSelected,\n        LookUp(\n            Var_upc_ConstanciaOrdenMerito,\n            idSolicitud = Value(ThisItem.ID)\n        )\n    );\n    Set(\n        varModalDetallesConstanciaOrdenMerito,\n        true\n    );\n    If(\n        TramiteConstanciaOrdenMeritoSelected.EstadoPago = \"PAGADO\" &&\n        IsBlank(TramiteConstanciaOrdenMeritoSelected.Resultado),\n        Set(varEnableBotonDescargaCOM, true);\n        Set(varEnableResultadoErrorCOM, false),        \n        !IsBlank(TramiteConstanciaOrdenMeritoSelected.Resultado),\n        Set(varEnableBotonDescargaCOM, false);\n        Set(varEnableResultadoErrorCOM, true),\n        Set(varEnableBotonDescargaCOM, false);\n        Set(varEnableResultadoErrorCOM, false)\n    )\n    , //EMISON DE CARTA DE PRESENTACION\n    ThisItem.codigoSolicitud = \"ECARTPRES\",\n    Refresh(Var_upc_EmisionCartaPresentacion);\n    Refresh(Var_upc_Solicitud);\n\n    ClearCollect(\n        col_ECARTPRES,\n        Last(\n            Filter(\n                Var_upc_EmisionCartaPresentacion,\n                idSolicitud = Value(ThisItem.ID)\n            )\n        )\n    );\n    ClearCollect(\n        Col_SolicitudSelectedECARTPRES,\n        Last(\n            Filter(\n                Var_upc_Solicitud,\n            ID      = Value(ThisItem.ID)\n            )\n        )\n    );\n    Set( col_EmisionCartaF ,First(col_ECARTPRES)); \n    Set( col_SolicitudEmisionCartaF,First(Col_SolicitudSelectedECARTPRES))  ; \n    UpdateContext({Var_VisibleEmisCartPresent:true});\n\n    ,\n    // Validación CONVALIDACIÓN DE ASIGNATURAS EXTERNAS\n    ThisItem.codigoSolicitud = \"CONVASIGEX\",\n    Concurrent(\n    Clear(col_ConvalidacionAsignaturasExternas),\n    Refresh(Var_upc_ConvalidacionAsignaturasExternas));\n    Set(\n        TramiteConvalidacionAsignaturasExternasSelected,\n        LookUp(\n            Var_upc_ConvalidacionAsignaturasExternas,\n            idSolicitud = Value(ThisItem.ID)\n        )\n    );\n    //Clear(col_ConvalidacionAsignaturasExternas);;\n    Collect(col_ConvalidacionAsignaturasExternas,\n        ForAll(\n            Table(ParseJSON(TramiteConvalidacionAsignaturasExternasSelected.jsonAsignaturasConvalidar)),\n            {\n                AbreviaturaArea: Text(Value.AbreviaturaArea),\n                NombreArea: Text(Value.NombreArea),\n                AsignaturaConvalidar: Text(Value.AsignaturaConvalidar),\n                CodigoAsignatura: Text(Value.CodigoAsignatura),\n                CodigoMateria: Text(Value.CodigoMateria),\n                CodigoPeriodo: Text(Value.CodigoPeriodo),\n                InstitucionExterna: Text(Value.InstitucionExterna),\n                OtraInstitucion: Text(Value.OtraInstitucion),\n                CarreraInstitucion: Text(Value.CarreraInstitucion),\n                CursoInstitucion: Text(Value.CursoInstitucion),\n                AñoSilabo: Text(Value.AñoSilabo),\n                AñoCertificado: Text(Value.AñoCertificado),\n                Ciclo: Text(Value.Ciclo),\n                Nota: Text(Value.Nota),\n                HorasCreditosTotales: Text(Value.HorasCreditosTotales),\n                HorasCreditosDistancia: Text(Value.HorasCreditosDistancia),\n                HorasCreditosPresencial: Text(Value.HorasCreditosPresencial),\n                UsuarioAplicacion: Text(Value.UsuarioAplicacion),\n                FechaResolucion: Text(Value.FechaResolucion),\n                UsuarioFinal: Text(Value.UsuarioFinal),\n                TipoConvalidacion: Text(Value.TipoConvalidacion),\n                EstadoConvalidacion: Text(Value.EstadoConvalidacion)\n            }\n        )\n    );\n    Set(\n        varModalDetalleConvalidacionAsignaturasExternas,\n        true\n    ),\n    // Validación EMISIÓN SÍLABOS\n    ThisItem.codigoSolicitud = \"EMSIL\",\n    Refresh(var_upc_EmisionSilabo);\n    Set(\n        TramiteEmisionSilabosSelected,\n        LookUp(\n            var_upc_EmisionSilabo,\n                //idSolicitud = Value(ThisItem.ID)\n            codigoSolicitud = Value(ThisItem.ID)\n        )\n    );\n    Refresh(Var_upc_Solicitud);\n    Set(\n        TramiteEmisionSilabosSolicitudSelected,\n            LookUp(\n                Var_upc_Solicitud,\n                ID = Value(ThisItem.ID)\n            )\n    );\n    Set(\n        varModalDetallesEmisionSilabos,\n        true\n    ),\n//Validacion EGRESADO BACHILLER\n    ThisItem.codigoSolicitud = \"TREB\",\n    Set(var_solicitudTRA008,Value(ThisItem.ID));\n    Set(var_CodigoUsuario,Text(ThisItem.codigoUsuario));\n    Set(var_NivelAlumno,Text(ThisItem.nivelAlumno));\n\n    Refresh(Var_upc_Solicitud);\n    ClearCollect(col_tramiteEgreBachSolicitudSelected,\n        Last(Filter(Var_upc_Solicitud,ID = Value(ThisItem.ID)))\n    );\n    Refresh(Var_upc_EgresadoBachiller);\n    ClearCollect(col_tramiteEgresadoBachillerSelected,\n        Last(Filter(Var_upc_EgresadoBachiller,idSolicitud = Value(ThisItem.ID)))\n    );\n    \n    //Datos para componente detalle Egresado - lectura de json enviado de app egresado\n\n    Set(var_cumpleFotos,\n        If(First(Filter(Var_upc_WebFotos,codigoUsuario=Concatenate(\"U\",varAlumno.codigoAlumno),productoId=Text(6))).estatusWebFotos=\"Correcto\",\"CUMPLIDO\",\"PENDIENTE\")\n    );\n    If(\n        First(col_tramiteEgreBachSolicitudSelected).estadoSolicitud = \"PROCEDE\" Or \n        First(col_tramiteEgreBachSolicitudSelected).estadoSolicitud = \"NO PROCEDE\" Or\n        First(col_tramiteEgreBachSolicitudSelected).estadoSolicitud = \"ANULADA\" Or\n        //First(col_tramiteEgreBachSolicitudSelected).flagLog = \"Si\" Or\n        First(col_tramiteEgreBachSolicitudSelected).flagPost = \"No\" Or\n        First(col_tramiteEgreBachSolicitudSelected).flagPost = \"Si\",\n        Set(var_resultadoEgresadoBachiller,true),\n        Set(var_resultadoEgresadoBachiller,false)\n    );\n\n    //===>>>>\n    //INICIO tabla requisitos academicos\n    Set(var_TipoObligatoria,\"O\");\n    Set(var_TipoComplementaria,\"C\");\n\n    Refresh(Var_upc_Alumno);\n    Set(varAlumno,LookUp(Var_upc_Alumno,codigoUsuario=var_CodigoUsuario&&Nivel=var_NivelAlumno));\n    Concurrent(\n        Set(var_Parsejsonmalla,ParseJSON(varAlumno.jsonMallaCurricular)),\n        Set(var_ParsejsonAvanAcade,ParseJSON(varAlumno.jsonAvanceCurricular))\n    );\n\n    //CREAR coleccion de areas obligatorias de MALLA\n    ClearCollect(colMallaCurriObli,\n        ForAll(Table(var_Parsejsonmalla.detalle.requerimientoPrograma.listaAreasObligatorias),\n            {\n                tipoArea:var_TipoObligatoria,\n                nombre:Text(Value.nombre),\n                estado:Text(Value.estado),\n                prioridad:Value(Value.prioridad)\n            }\n        )\n    );\n    RemoveIf(colMallaCurriObli,Right(nombre,2)=\"00\");\n    //CREAR coleccion de areas complementarias de MALLA\n    ClearCollect(colMallaCurriComp,\n        ForAll(Table(var_Parsejsonmalla.detalle.requerimientoPrograma.listaAreasComplementarias),\n            {\n