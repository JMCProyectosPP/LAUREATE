      - Btn_Login:
          Control: Classic/Button@2.2.0
          Properties:
            Color: =RGBA(255, 255, 255, 1)
            Fill: =RGBA(229, 10, 23, 1)
            HoverColor: =RGBA(255, 255, 255, 1)
            HoverFill: =RGBA(229, 10, 23, 0.5)
            OnSelect: |-
              =//Modal de carga
              Set(
                  varModalCarga,
                  true
              );
              //Refrescar listas
              Refresh(Var_upc_HistoricoSolicitudesAlumno);
              //Código de usuario
              Set(
                  varCodigoUsuario,
                  Upper(TrimEnds(Txt_CodUsuario.Text))
              );
              //Buscar elemento
              Set(
                  varRegistroSharepoint,
                  LookUp(
                      Var_upc_HistoricoSolicitudesAlumno,
                      codigoUsuario = varCodigoUsuario
                  )
              );
              //Patch extraer SQL
              If(
                  IsBlank(
                      varRegistroSharepoint
                  ),
                  Patch(
                      Var_upc_HistoricoSolicitudesAlumno,
                      Defaults(Var_upc_HistoricoSolicitudesAlumno),
                      {
                          codigoUsuario: varCodigoUsuario,
                          periodo: If(
                              IsBlank(Cbx_Periodo.Selected.codigo),
                              varTablaJSONConfiguraciones.varFiltroTodos,
                              Cbx_Periodo.Selected.codigo
                          ),
                          flagConsulta: varTablaJSONConfiguraciones.varFlagSi
                      }
                  ),
                  Patch(
                      Var_upc_HistoricoSolicitudesAlumno,
                      varRegistroSharepoint,
                      {
                          periodo: If(
                              IsBlank(Cbx_Periodo.Selected.codigo),
                              varTablaJSONConfiguraciones.varFiltroTodos,
                              Cbx_Periodo.Selected.codigo
                          ),
                          flagConsulta: varTablaJSONConfiguraciones.varFlagSi
                      }
                  )
              );
              Set(
                  varIniciarTimer,
                  true
              )
            RadiusBottomLeft: =20
            RadiusBottomRight: =20
            RadiusTopLeft: =20
            RadiusTopRight: =20
            Size: =18
            Text: ="INGRESO"
            Width: =320
            X: =221
            Y: =538
