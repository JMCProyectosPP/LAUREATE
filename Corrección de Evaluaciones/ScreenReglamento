      - Timer1:
          Control: Timer@2.1.0
          Properties:
            AutoPause: =varPausarRecolectarNotas
            AutoStart: =varIniciarRecolectarNotas
            BorderColor: =ColorFade(Self.Fill, -15%)
            Color: =RGBA(255, 255, 255, 1)
            DisabledBorderColor: =ColorFade(Self.BorderColor, 70%)
            DisabledColor: =ColorFade(Self.Fill, 90%)
            DisabledFill: =ColorFade(Self.Fill, 70%)
            Duration: =3000
            Fill: =RGBA(164, 38, 44, 1)
            Font: =Font.'Open Sans'
            HoverBorderColor: =ColorFade(Self.BorderColor, 20%)
            HoverColor: =RGBA(255, 255, 255, 1)
            HoverFill: =ColorFade(RGBA(164, 38, 44, 1), -20%)
            OnTimerEnd: |
              =
              Set(varDuracionEspera, Timer1.Duration + varDuracionEspera);
              Set(varMaximaDuracionEsperaWS,120000);//2 min
              Refresh(Var_upc_Alumno);
              Set(
                  varTieneDetMatricula,
                  !IsBlank(
                      LookUp(
                          Var_upc_Alumno,
                          codigoUsuario = varCodigoUsuario && Nivel = varUsuarioNivel,
                          jsonDetalleMatricula
                      )
                  )
              );
              Set(
                  varTieneNotas,
                  !IsBlank(
                      LookUp(
                          Var_upc_Alumno,
                          codigoUsuario = varCodigoUsuario && Nivel = varUsuarioNivel,
                          jsonAvanceNotas
                      )
                  )
              );
              Set(
                  varNotasCargadas,
                  LookUp(
                      Var_upc_Alumno,
                      codigoUsuario = varCodigoUsuario && Nivel = varUsuarioNivel,
                      flagAvanceNotas
                  )
              );

              If(
                  varNotasCargadas="No" && varTieneDetMatricula,
                      Set(varRepetirRecolectarNotas,false);
                      Set(varPausarRecolectarNotas,true);
                      Set(varIniciarRecolectarNotas,false);
                      Set(var_modalCargaHome,false);
                      Navigate(ScreenImportante)
                  ,
                  If(varDuracionEspera < varMaximaDuracionEsperaWS && (varNotasCargadas = "Si" Or IsBlank(varNotasCargadas)),
                          Set(varRepetirRecolectarNotas,true);
                          Set(varPausarRecolectarNotas,false);
                          Set(varIniciarRecolectarNotas,true)
                      ,
                          Set(varRepetirRecolectarNotas,false);
                          Set(varPausarRecolectarNotas,true);
                          Set(varIniciarRecolectarNotas,false);
                          Set(var_modalCargaHome,false);
                          Set(varModalError,true);
                          Set(varErrorMensaje,LookUp(colGlosasValidacionesRequeridas,codigoGlosa = TablaGlosas.codigoGlosaFaltaInfoWS,mensajeGlosa));

                  )

              )
            OnTimerStart: =Refresh(Var_upc_Alumno)
            PressedBorderColor: =Self.Fill
            PressedColor: =Self.Fill
            PressedFill: =Self.Color
            Repeat: =varRepetirRecolectarNotas
            Visible: =false
            X: =19
            Y: =714
