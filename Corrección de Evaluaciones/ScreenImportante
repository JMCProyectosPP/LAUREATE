            OnSelect: "=//Presenta modal de carga\nSet(var_modalCargaHome,true);\n//Considera deshabilitar en forma inicial el botón SIGUIENTE\nSet(\n    varModalError,\n    false\n);\nClear(colTIpoEvaluacionCorreccion);\n\n\n//Validaciones\nRefresh(Var_upc_Validacion);\nRefresh(Var_upc_ConfiguracionTramiteVigencia);\n\n//Filtrar asignaturas por estado de inscripción\nClearCollect(\n    colDetalleMatricula,\n    Filter(\n        colDetalleMatricula,\n        (\n            //estadoInscripcionCodigo = TablaConfiguracion.EstadoInscripcionCodigoRW || \n            //estadoInscripcionCodigo = TablaConfiguracion.EstadoInscripcionCodigoRE\n            estadoInscripcionCodigo in TablaConfiguracion.EstadoInscripcionCodigos\n        )\n    )\n);\n\n//Valida curso cuyo \"codigo\" de \"estadoInscripcion\" sea RW o RE - REQ009\nSet(varContMatriculaCursosHabiles,\n    CountRows(\n        colDetalleMatricula\n    )\n);\n\n//Creamos la coleccion de las Validaciones de la Pantalla \nClearCollect(colValidaciones,\n    Filter(Var_upc_Validacion,\n        estado.Value=TablaConfiguracion.filtroEstadoValidacion\n        && codigoConfiguracionTramite.Value=var_confTRam\n    )\n);\n\n//Validación de los requisitos\nClear(colCumpleValidacion);\n\nForAll(Sort(colValidaciones,orden,SortOrder.Ascending),\n    Switch(ThisRecord.codigoRequisito.Value,    \n    \"REQ003\", //Información de matrícula\n        Collect(colCumpleValidacion,{\n        Codigo:ThisRecord.codigoRequisito.Value,\n        Cumple:If(!IsBlank(varAlumno.jsonMatricula) && !IsBlank(varAlumno.jsonDetalleMatricula),\n                    \"Si\",\"No\"), \n        Glosa:ThisRecord.codigoGlosa.Value}),\n    \"REQ009\", //Validación de cursos hábiles\n        Collect(colCumpleValidacion,{\n        Codigo:ThisRecord.codigoRequisito.Value,\n        Cumple:If(varContMatriculaCursosHabiles > 0,\n                \"Si\",\"No\"),\n        Glosa:ThisRecord.codigoGlosa.Value}))\n);\n\nSet(var_ResultadoValidacion,Filter(colCumpleValidacion,Cumple=\"No\"));\nSet(var_ResultadoValidacionFirst,First(var_ResultadoValidacion));\n\n//Comprobamos las validaciones \nRefresh(Var_upc_Glosa);\n\nIf(\n    CountRows(var_ResultadoValidacion)<>0,\n    Switch(var_ResultadoValidacionFirst.Codigo,\n        \"REQ003\", //Información de matrícula\n        Set(varErrorMensaje,\n        LookUp(Var_upc_Glosa,codigoGlosa=var_ResultadoValidacionFirst.Glosa,mensajeGlosa)),\n        \"REQ009\", //Validación de cursos hábiles\n        Set(varErrorMensaje,\n        LookUp(Var_upc_Glosa,codigoGlosa=var_ResultadoValidacionFirst.Glosa,mensajeGlosa))\n    );\n    Set(\n        varModalError,\n        true\n    )\n);\n\nIf(!varModalError,\n    Refresh(Var_upc_Alumno);\n    Set(\n        tblDocenteSeccion,\n        Table(ParseJSON(\n            LookUp(\n                Var_upc_Alumno,\n                codigoUsuario = varCodigoUsuario && Nivel=varUsuarioNivel,jsonDocenteSeccion)\n            )\n        )\n    );\n    Clear(colDocenteSeccion);\n    ForAll(\n        tblDocenteSeccion,\n        Collect(\n            colDocenteSeccion,\n            {\n                Id: CountRows(colDocenteSeccion),\n                DisplayName: Concatenate(\n                    ThisRecord.Value.nombres,\n                    \" \",\n                    ThisRecord.Value.apellidos\n                ),\n                codigoPeriodo: ThisRecord.Value.codigoPeriodo,\n                nrc: ThisRecord.Value.nrc,\n                correoDocente: ThisRecord.Value.correoDocente,\n                docentePrincipal: Text( ThisRecord.Value.docentePrincipal),\n                usuarioDocente: Text(ThisRecord.Value.usuarioDocente)\n            }\n        )\n    );\n    Set(\n        tblAvanceNotas,\n        Table(ParseJSON(     \n            LookUp(\n                Var_upc_Alumno,\n                codigoUsuario = varCodigoUsuario && Nivel=varUsuarioNivel,jsonAvanceNotas)\n            )\n        )	\n    );\n    Clear(colAvanceNotas);\n    ForAll(\n        tblAvanceNotas,\n        Collect(\n            colAvanceNotas,\n            {\n                Id: CountRows(colAvanceNotas),\n                DisplayName: ThisRecord.Value.DesTipoPrueba,\n                CodTipoPrueba: ThisRecord.Value.CodTipoPrueba,\n                Nota: ThisRecord.Value.Nota,\n                CodCurso: ThisRecord.Value.CodCurso,\n                DescCurso: ThisRecord.Value.DescCurso\n            }\n        )\n    );\n    \n    Set(varHabilitarEnviarSol,false);\n     //limpiar seccion de reclamo\n    Reset(dpTipoReclamo);    \n    Reset(txtErrorSuma);\n    Reset(txtErrorSuma);\n    Reset(txtErrorDigitacion);\n    Concurrent(\n        Clear(colPreguntas),\n        Reset(txtPreguntaCorregidaParcialmente)\n    );\n    Concurrent(\n        Clear(colPreguntas),\n        Reset(txtPreguntaNoCorregida)\n    );\n   Concurrent(\n        Clear(colPreguntas),\n        Reset(txtPreguntaNoCorregida)\n    );\n    Concurrent(\n        Reset(dropSubTipoReclamo),\n        Reset(dropActividad),\n        Clear(colPreguntasProblemas)\n    );\n    Concurrent(\n        Reset(txtNoConsidero1),\n        Reset(txtNoConsidero2)\n    );\n    Navigate(ScreenRegistro)\n);\n//Oculta modal de carga\nSet(var_modalCargaHome,false)"
