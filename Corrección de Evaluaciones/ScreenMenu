            OnTimerEnd: "=Set(var_modalCargaHome, true );\r\nIf(\r\n    iniciarTimerRegular,\r\n    Concurrent(\r\n        Clear(colDetalleMatricula),\r\n        Clear(colDocenteSeccion)\r\n    );\r\n    Refresh(Var_upc_Alumno);\r\n    Set(\r\n        varAlumno,\r\n        LookUp(\r\n            Var_upc_Alumno,\r\n            codigoUsuario = varCodigoUsuario && Nivel=varUsuarioNivel\r\n        )\r\n    );\r\n    Set(\r\n        tblDetalleMatricula,\r\n        Table(ParseJSON(varAlumno.jsonDetalleMatricula))\r\n    );\r\n    Set(\r\n        tblDocenteSeccion,\r\n        Table(ParseJSON(varAlumno.jsonDocenteSeccion))\r\n    );\r\n    Set(\r\n        varAlumnoJson,\r\n        ParseJSON(varAlumno.jsonAlumno)\r\n    );\r\n    ForAll(\r\n        tblDocenteSeccion,\r\n        Collect(\r\n            colDocenteSeccion,\r\n            {\r\n                Id: CountRows(colDocenteSeccion),\r\n                DisplayName: Concatenate(\r\n                    ThisRecord.Value.nombres,\r\n                    \" \",\r\n                    ThisRecord.Value.apellidos\r\n                ),\r\n                codigoPeriodo: ThisRecord.Value.codigoPeriodo,\r\n                nrc: ThisRecord.Value.nrc,\r\n                correoDocente: ThisRecord.Value.correoDocente,\r\n                docentePrincipal: Text( ThisRecord.Value.docentePrincipal),\r\n                usuarioDocente: Text(ThisRecord.Value.usuarioDocente)\r\n            }\r\n        )\r\n    );\r\n    //Detalle de matrícula\r\n    ForAll(\r\n        tblDetalleMatricula,\r\n        Collect(\r\n            colDetalleMatricula,\r\n            {\r\n                Id: CountRows(colDetalleMatricula),\r\n                DisplayName: Concatenate(\r\n                    ThisRecord.Value.MateriaCodigo,\r\n                    ThisRecord.Value.numeroCurso,\r\n                    \" - \",\r\n                    ThisRecord.Value.MateriaDescripcion\r\n                ),\r\n                materia: Text(ThisRecord.Value.MateriaDescripcion),\r\n                nrc: Text(ThisRecord.Value.nrc),\r\n                numeroCurso: Text(ThisRecord.Value.numeroCurso),\r\n                materiaCodigo: Text(ThisRecord.Value.MateriaCodigo),\r\n                codCurso: Concatenate(\r\n                    ThisRecord.Value.MateriaCodigo,\r\n                    ThisRecord.Value.numeroCurso\r\n                ),\r\n                estadoInscripcionCodigo: Text(ThisRecord.Value.estadoInscripcionCodigo),\r\n                partePeriodocodigo:Text(ThisRecord.Value.partePeriodocodigo)\r\n            }\r\n        )\r\n    );\r\n    // ------------------------ VIGENCIAS MODULARES ----------------------------- //\r\n    // OBTENER PARTE PERIODO CÓDIGO DE DETALLE MATRÍCULA\r\n    ClearCollect(\r\n        col_detalleMatricula,\r\n        ForAll(\r\n            tblDetalleMatricula,\r\n            {\r\n                partePeriodocodigo:Text(Value.partePeriodocodigo)\r\n            }\r\n        )\r\n    );\r\n    ClearCollect(\r\n        col_VigenciasModulares,\r\n        {\r\n            //MÓDULO A\r\n            moduloA:If(IsBlank(LookUp(col_detalleMatricula,partePeriodocodigo=TablaConfiguracion.valorModuloA).partePeriodocodigo),\"No\",\"Si\"),\r\n            //MÓDULO B\r\n            moduloB:If(IsBlank(LookUp(col_detalleMatricula,partePeriodocodigo=TablaConfiguracion.valorModuloB).partePeriodocodigo),\"No\",\"Si\"),\r\n            //MÓDULO RE\r\n            modulo1:If(IsBlank(LookUp(col_detalleMatricula,partePeriodocodigo=TablaConfiguracion.valorModuloRE).partePeriodocodigo),\"No\",\"Si\")\r\n        }\r\n    );\r\n\r\n    //Sanciones a aplicar para cursos desde la lista de mantenimientos\r\n    ClearCollect(\r\n        colTiposSancionesTramiteCurso,\r\n        Filter(\r\n            Var_upc_ConfiguracionTramiteSancion,\r\n            codigoConfiguracionTramite.Value = varConfiguracionTramite.codigoConfiguracionTramite \r\n            && activo.Value = TablaConfiguracion.filtroEstadoActivoSancion//\"Si\" \r\n            && (\r\n                codigoTipoSancion.Value = TablaConfiguracion.TipoSancion04 //varTipoSancion04 \r\n            )\r\n        )\r\n    );\r\n    //Todo el registro de la configuración del trámite\r\n    Set(varConfiguracionTramite,\r\n        LookUp(Var_upc_ConfiguracionTramite,And(codigoTramite.Value=var_TramiteRealizar,codigoNivel.Value = varAlumno.Nivel))\r\n    );\r\n\r\n    //Columna codigoConfiguracionTramite desde la configuración del trámite\r\n    Set(var_confTRam,\r\n        LookUp(Var_upc_ConfiguracionTramite,And(codigoTramite.Value=var_TramiteRealizar,codigoNivel.Value = varAlumno.Nivel),codigoConfiguracionTramite)\r\n    );\r\n\r\n    //Tipo de duracion\r\n    Set(varTipoDuracion,\r\n        LookUp(Var_upc_TipoDuracion, codigoTipoDuracion = TablaConfiguracion.codigoTipoDuracion2, nombreTipoDuracion)\r\n    );\r\n    \r\n    //Configuracion actividades\r\n    Refresh(Var_upc_ConfiguracionTramiteActividades);\r\n    ClearCollect(col_ActividadesAD,\r\n        Filter(Var_upc_ConfiguracionTramiteActividades,\r\n            And(codigoConfiguracionTramite.Value = var_confTRam,estado.Value = TablaConfiguracion.codigoEstadoActividad)\r\n        )\r\n    );\r\n    //Obtener actividad de registro\r\n    Set(var_PrimeraActividad,\r\n        LookUp(col_ActividadesAD,orden = TablaConfiguracion.numOrdenPrimeraActividad)\r\n    );\r\n\r\n    //Reglamentos\r\n    //Se filtra el reglamento del tramite seleccionado\r\n    Refresh(Var_upc_Reglamento);\r\n    Set(varReglamento,First(Filter(Var_upc_Reglamento,codigoReglamento = varCodigoReglamento.Value)));\r\n\r\n    //Validaciones informacion en campos de pantalla de registro\r\n    Refresh(Var_upc_Glosa);\r\n    ClearCollect(colGlosasValidacionesRequeridas,\r\n        Filter(Var_upc_Glosa,\r\n            codigoTramite= var_TramiteRealizar\r\n        )\r\n    );\r\n\r\n    //Validaciones\r\n    Refresh(Var_upc_Validacion);\r\n    Refresh(Var_upc_ConfiguracionTramiteVigencia);\r\n\r\n    //Obtenemos la configuracion de vigencia del tramite de la lista configuracion de vigencia REQ001 Vigencia sin periodo y con fecha\r\n    ClearCollect(colVigencia,\r\n        Filter(Var_upc_ConfiguracionTramiteVigencia,\r\n        codigoConfiguracionTramite.Value= Text( var_confTRam) \r\n        && nivel=varAlumno.Nivel\r\n        && codigoModalidad=varAlumno.modalidadEstudio\r\n        && estado.Value= TablaConfiguracion.filtroEstadoVigencia\r\n        && (\r\n            fechaInicio<=Today() && fechaFin>=Today()\r\n        )\r\n    ));\r\n\r\n    //Validar si existen vigencias para el periodo - REQ099 Vigencia por periodo sin fecha\r\n    ClearCollect(colVigenciaPorPeriodo,\r\n        Filter(Var_upc_ConfiguracionTramiteVigencia,\r\n        codigoConfiguracionTramite.Value=Text( var_confTRam) \r\n        && nivel=varAlumno.Nivel\r\n        && codigoModalidad=varAlumno.modalidadEstudio\r\n        && periodoCompuesto=varAlumno.Periodo\r\n    ));\r\n\r\n    //Obtenemos la configuracion de vigencia del tramite de la lista configuracion de vigencia Regular REQ008 Vigencia por periodo y con fecha\r\n    //Regular o Modular(AC - 01- 10-20)\r\n    ClearCollect(colvigenciaperiodoRegular,\r\n        Filter(Var_upc_ConfiguracionTramiteVigencia,\r\n        codigoConfiguracionTramite.Value=Text( var_confTRam) \r\n        && nivel=varAlumno.Nivel\r\n        && codigoModalidad=varAlumno.modalidadEstudio\r\n        && periodoCompuesto=varAlumno.Periodo\r\n        && estado.Value=TablaConfiguracion.filtroEstadoVigencia \r\n        && (\r\n            fechaInicio<=Today() && fechaFin>=Today()\r\n        )\r\n    ));\r\n\r\n    //Obtenemos la configuracion de vigencia del tramite de la lista configuracion de vigencia Regular por periodo\r\n    ClearCollect(colvigenciaperiodoInfo,\r\n    Filter(Var_upc_ConfiguracionTramiteVigencia,\r\n        codigoConfiguracionTramite.Value= Text(var_confTRam) \r\n        && nivel=varAlumno.Nivel \r\n        && codigoModalidad=varAlumno.modalidadEstudio \r\n        && estado.Value=TablaConfiguracion.filtroEstadoVigencia\r\n        //&& periodoCompuesto=varAlumno.Periodo\r\n    ));\r\n\r\n    //Validación de vigencia modular\r\n    //Se busca alguna vigencia configurada con modulo A\r\n    If(\r\n        First(col_VigenciasModulares).moduloA = \"Si\",\r\n        Set(\r\n            var_vigenciaA,\r\n            If(\r\n                !IsBlank(\r\n                    LookUp(\r\n                        Var_upc_ConfiguracionTramiteVigencia,\r\n                        codigoConfiguracionTramite.Value = varConfiguracionTramite.codigoConfiguracionTramite \r\n                        && nivel = varAlumno.Nivel \r\n                        && flagModular = TablaConfiguracion.filtroVigenciaModular\r\n                        && codigoModulo = TablaConfiguracion.valorModuloA\r\n                        && codigoModalidad = varAlumno.modalidadEstudio\r\n                        && estado.Value = TablaConfiguracion.filtroEstadoVigencia\r\n                        && (\r\n                            fechaInicio <= Today() && fechaFin >= Today()\r\n                        )\r\n                    )\r\n                ),\r\n                \"Si\",\r\n                \"No\"\r\n            )\r\n        ),\r\n        Set(\r\n            var_vigenciaA,\r\n            \"No\"\r\n        )\r\n    );\r\n    //Se busca alguna vigencia configurada con modulo B\r\n    If(\r\n        First(col_VigenciasModulares).moduloB = \"Si\",\r\n        Set(\r\n            var_vigenciaB,\r\n            If(\r\n                !IsBlank(\r\n                    LookUp(\r\n                        Var_upc_ConfiguracionTramiteVigencia,\r\n                        codigoConfiguracionTramite.Value = varConfiguracionTramite.codigoConfiguracionTramite \r\n                        && nivel = varAlumno.Nivel \r\n                        && flagModular = TablaConfiguracion.filtroVigenciaModular\r\n                        && codigoModulo = TablaConfiguracion.valorModuloB\r\n                        && codigoModalidad = varAlumno.modalidadEstudio\r\n                        && estado.Value = TablaConfiguracion.filtroEstadoVigencia\r\n                        && (\r\n                            fechaInicio <= Today() && fechaFin >= Today()\r\n                        )\r\n                    )\r\n                ),\r\n                \"Si\",\r\n                \"No\"\r\n            )\r\n        ),\r\n        Set(\r\n            var_vigenciaB,\r\n            \"No\"\r\n        )\r\n    );\r\n    //Se busca alguna vigencia configurada con modulo 1\r\n    If(\r\n        First(col_VigenciasModulares).modulo1 = \"Si\",\r\n        Set(\r\n            var_vigencia1,\r\n            If(\r\n                !IsBlank(\r\n                    LookUp(\r\n                        Var_upc_ConfiguracionTramiteVigencia,\r\n                        codigoConfiguracionTramite.Value = varConfiguracionTramite.codigoConfiguracionTramite \r\n                        && nivel = varAlumno.Nivel \r\n                        && flagModular = TablaConfiguracion.filtroVigenciaModular\r\n                        && codigoModulo = TablaConfiguracion.valorModuloRE\r\n                        && codigoModalidad = varAlumno.modalidadEstudio\r\n                        && estado.Value = TablaConfiguracion.filtroEstadoVigencia\r\n                        && (\r\n                            fechaInicio <= Today() && fechaFin >= Today()\r\n                        )\r\n                    )\r\n                ),\r\n                \"Si\",\r\n                \"No\"\r\n            )\r\n        ),\r\n        Set(\r\n            var_vigencia1,\r\n            \"No\"\r\n        )\r\n    );\r\n\r\n    Clear(colVigenciasActivas);\r\n    If(varAlumno.modalidadEstudio = TablaConfiguracion.valorModalidadEPE,\r\n        \r\n        If(var_vigenciaA = \"Si\",\r\n            Collect(colVigenciasActivas,\r\n                {\r\n                    modulo: TablaConfiguracion.valorModuloA,\r\n                    vigente: \"Si\"\r\n                }\r\n            )\r\n        );\r\n        If(var_vigenciaB = \"Si\",\r\n        Collect(colVigenciasActivas,\r\n                {\r\n                    modulo: TablaConfiguracion.valorModuloB,\r\n                    vigente: \"Si\"\r\n                }\r\n            )\r\n        );\r\n        If(var_vigencia1 = \"Si\",\r\n            Collect(colVigenciasActivas,\r\n                {\r\n                    modulo: TablaConfiguracion.valorModuloRE,\r\n                    vigente: \"Si\"\r\n                }\r\n            )\r\n        )\r\n    );\r\n\r\n    //Obtenemos la coleccion de validaciones - Pantalla 1 \r\n    ClearCollect(colValidaciones,\r\n        Filter(Var_upc_Validacion,\r\n            estado.Value = TablaConfiguracion.filtroEstadoValidacion\r\n            && codigoConfiguracionTramite.Value=var_confTRam \r\n            && (codigoRequisito.Value = If(\r\n                    varUsuarioRol = TablaConfiguracion.RolAlumno,\"REQ001\",\"\") || //REQ001 Vigencia sin periodo y con fecha  \r\n                //codigoRequisito.Value = \"REQ008\" || //REQ008 Vigencia por periodo y con fecha\r\n                codigoRequisito.Value = If(\r\n                    varUsuarioRol = TablaConfiguracion.RolAlumno,\"REQ099\",\"\") || //REQ099 Vigencia por periodo sin fecha\r\n                codigoRequisito.Value = If(\r\n                    varUsuarioRol = TablaConfiguracion.RolAlumno,\r\n                    If(\r\n                        varAlumno.modalidadEstudio = TablaConfiguracion.valorModalidadEPE,\r\n                        \"REQ040\",\r\n                        varAlumno.modalidadEstudio = TablaConfiguracion.valorModalidadPregrado,\r\n                        \"REQ008\"\r\n                    ),\r\n                    \"\"\r\n                )            \r\n            )\r\n        )\r\n    );\r\n\r\n    //Validación de los requisitos\r\n    Set(varModalError,false);\r\n    Clear(colCumpleValidacion);\r\n\r\n    ForAll(Sort(colValidaciones,orden,SortOrder.Ascending),\r\n        Switch(ThisRecord.codigoRequisito.Value,    \r\n            \"REQ001\", //REQ001 Vigencia sin periodo y con fecha\r\n            Collect(colCumpleValidacion,{\r\n                Codigo:ThisRecord.codigoRequisito.Value,\r\n                Cumple:If(CountRows(colVigencia)>0,\"Si\",\"No\"), \r\n                Glosa:ThisRecord.codigoGlosa.Value}),\r\n            \"REQ099\", //REQ099 Vigencia por periodo sin fecha\r\n            Collect(colCumpleValidacion,{\r\n                Codigo:ThisRecord.codigoRequisito.Value,\r\n                Cumple:If(CountRows(colVigenciaPorPeriodo)>0,\"Si\",\"No\"),\r\n                Glosa:ThisRecord.codigoGlosa.Value}),            \r\n            \"REQ008\", //REQ008 Vigencia por periodo y con fecha\r\n            Collect(colCumpleValidacion,{\r\n                Codigo:ThisRecord.codigoRequisito.Value,\r\n                Cumple:If(CountRows(colvigenciaperiodoRegular)>0,\"Si\",\"No\"),\r\n                Glosa:ThisRecord.codigoGlosa.Value}),\r\n            \"REQ040\",\r\n            Collect(\r\n                colCumpleValidacion,\r\n                {\r\n                    Codigo: ThisRecord.codigoRequisito.Value,\r\n                    Cumple: If(\r\n                        Or(\r\n                            var_vigenciaA = \"Si\",\r\n                            var_vigenciaB = \"Si\",\r\n                            var_vigencia1 = \"Si\"\r\n                        ),\r\n                        \"Si\",\r\n                        \"No\"\r\n                    ),\r\n                    Glosa: ThisRecord.codigoGlosa.Value\r\n                }\r\n            )                \r\n        )\r\n    );\r\n\r\n    Set(var_ResultadoValidacion,Filter(colCumpleValidacion,Cumple=\"No\"));\r\n    Set(var_ResultadoValidacionFirst,First(var_ResultadoValidacion));\r\n\r\n    //Comprobamos las validaciones \r\n    Refresh(Var_upc_Glosa);\r\n\r\n    //Se obtiene como objeto la informacion de la vigencia por periodo\r\n    Set(var_vigenciaperiodoInfo,First(colvigenciaperiodoInfo));\r\n\r\n    If(\r\n        CountRows(var_ResultadoValidacion)<>0,\r\n        Switch(var_ResultadoValidacionFirst.Codigo,\r\n            \"REQ001\",\r\n                Set(varErrorMensaje,\r\n                    LookUp(Var_upc_Glosa,codigoGlosa=var_ResultadoValidacionFirst.Glosa,mensajeGlosa)),  \r\n            \"REQ099\",\r\n                Set(varErrorMensaje,\r\n                    LookUp(Var_upc_Glosa,codigoGlosa=var_ResultadoValidacionFirst.Glosa,mensajeGlosa)),\r\n            \"REQ008\",\r\n                Set(varErrorMensaje,\r\n                    Substitute(\r\n                        Substitute(\r\n                            Substitute(\r\n                                Substitute(\r\n                                    Substitute(\r\n                                        Substitute(\r\n                                            LookUp(Var_upc_Glosa,codigoGlosa=var_ResultadoValidacionFirst.Glosa,mensajeGlosa),\r\n                                            \"[[NIVEL]]\",varAlumno.Nivel),\r\n                                        \"[[PERIODO]]\",varAlumno.Periodo),\r\n                                    \"[[CT_VIGENCIA_INICIO]]\",var_vigenciaperiodoInfo.fechaInicio),\r\n                            \"[[CT_VIGENCIA_FIN]]\",var_vigenciaperiodoInfo.fechaFin)\r\n                        ,\"[[CT_NIVEL]]\",var_vigenciaperiodoInfo.confNivel.Value),\r\n                    \"[[CT_PERIODO]]\",var_vigenciaperiodoInfo.periodoCompuesto)\r\n                ),\r\n            \"REQ040\",\r\n                Set(\r\n                    varErrorMensaje,\r\n                    Substitute(\r\n                        Substitute(\r\n                            LookUp(\r\n                                Var_upc_Glosa,\r\n                                codigoGlosa = var_ResultadoValidacionFirst.Glosa,\r\n                                mensajeGlosa\r\n                            ),\r\n                            \"[[NIVEL]]\",\r\n                            varAlumno.Nivel\r\n                        ),\r\n                        \"[[PERIODO]]\",\r\n                        varAlumno.Periodo\r\n                    )\r\n                )        \r\n        );\r\n        Set(\r\n            varModalError,\r\n            true\r\n        )\r\n    );\r\n    Concurrent(\r\n        Set(repetirTimerRegular,false),\r\n        Set(iniciarTimerRegular,false),\r\n        Set(var_modalCargaHome,false)\r\n    );\r\n    If(\r\n        varModalError = false,\r\n        Navigate(ScreenReglamento)\r\n    )\r\n    \r\n\r\n)"
