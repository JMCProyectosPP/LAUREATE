            - Button4:
                Control: Classic/Button@2.2.0
                Properties:
                  BorderColor: =ColorFade(Self.Fill, -15%)
                  Color: =RGBA(255, 255, 255, 1)
                  DisabledBorderColor: =RGBA(166, 166, 166, 1)
                  Fill: =RGBA(255, 0, 0, 1)
                  Font: =Font.'Open Sans Condensed'
                  FontWeight: =FontWeight.Bold
                  HoverBorderColor: =ColorFade(Self.BorderColor, 20%)
                  HoverColor: =RGBA(255, 255, 255, 1)
                  HoverFill: =ColorFade(RGBA(164, 38, 44, 1), -20%)
                  OnSelect: |-
                    =//Variables ///////////////////////
                    Concurrent(
                        Set(
                            var_TramiteRealizar,
                            ThisItem.codigoTramite.Value
                        ),
                        Set(
                            var_NombreTramite,
                            ThisItem.'codigoTramite: nombreTramite'
                        ),
                        Set(
                            varCodigoTipoDuracion,
                            ThisItem.codigoTipoDuracion
                        ),
                        Set(
                            varCodigoReglamento,
                            ThisItem.codigoReglamento
                        ),
                        Clear(colDetalleMatricula),
                        Clear(colDocenteSeccion)
                    );

                    Set(
                        varTramiteInit,
                        LookUp(
                            Var_upc_Tramite,
                            codigoTramite = var_TramiteRealizar
                        )
                    );

                    //Mensaje de error para acutalización de alumnos en extraacadémicos
                    Set(var_TextAlertaErrorExtraAcademicos, 
                        LookUp(Var_upc_Glosa, 
                            codigoGlosa = TablaGlosas.codigoGlosaErrorExtraAcademicos, 
                            mensajeGlosa)
                    );

                    Set(
                        var_TextAlertaExtraAcademicos,
                        LookUp(
                            Var_upc_Glosa,
                            codigoGlosa = TablaGlosas.codigoGlosaTextAlertaExtraAcademicos, //"GLO784";
                            mensajeGlosa
                        )
                    );
                    Set(
                        var_havePeriodoExtraacademico,
                        !IsBlank(varTramiteInit.periodosExtraacademicos)
                    );
                    Set(
                        var_viewMdlCfrmPeriodo,
                        And(
                            var_haveExtra,
                            var_havePeriodoExtraacademico
                        )
                    );
                    If(
                        !var_haveExtra,
                        If(
                            IsError(
                                Patch(
                                    Var_upc_Alumno,
                                    LookUp(Var_upc_Alumno, codigoAlumno = varAlumno.codigoAlumno && Nivel = varAlumno.Nivel),
                                    {
                                        jsonDetalleMatricula: JSON(Filter(var_DetalleMatriculaPatch,codigoPeriodo = varAlumno.Periodo))
                                    }
                                )
                            )
                            ,
                            Set(varModalError,true);    
                            Set(varErrorMensaje, var_TextAlertaErrorExtraAcademicos)
                            ,
                            Set(iniciarTimerRegular,true);
                            Set(var_modalCargaHome, true )
                        ) 
                    );

                    If(
                        var_haveExtra && (var_viewMdlCfrmPeriodo = false),
                        If(
                            IsError(
                                Patch(
                                    Var_upc_Alumno,
                                    LookUp(Var_upc_Alumno, codigoAlumno = varAlumno.codigoAlumno && Nivel = varAlumno.Nivel),
                                    {
                                        jsonDetalleMatricula: JSON(LookUp(var_DetalleMatriculaPatch,codigoPeriodo = varAlumno.Periodo).cursos)
                                    }
                                )
                            )
                            ,
                            Set(varModalError,true);    
                            Set(varErrorMensaje, var_TextAlertaErrorExtraAcademicos)
                            ,
                            Set(iniciarTimerRegular,true)
                        )
                    )
                  PressedBorderColor: =Self.Fill
                  PressedColor: =Self.Fill
                  PressedFill: =Self.Color
                  RadiusBottomLeft: =0
                  RadiusBottomRight: =0
                  RadiusTopLeft: =0
                  RadiusTopRight: =0
                  Text: ="Iniciar trámite"
                  X: =701
                  Y: =67
