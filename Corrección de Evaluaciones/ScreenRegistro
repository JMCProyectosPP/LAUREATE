          Properties:
            BtnCerrar: |-
              =Clear(colValidaciones);
              Clear(colCumpleRegla);
              //Set(varErrorMensaje;"");;
              Set(varModalError,false);

              //Inico para registrar error
              Refresh(Var_upc_Log);
              Set(
                  varJsonLog,
                  LookUp(
                      Var_upc_Log,
                      codigoUsuario = varCodigoUsuario,
                      mensaje
                  )
              );
              ClearCollect(
                  colMensajeLog,
                  ForAll(
                      ParseJSON(varJsonLog),
                      {
                          fecha: Text(ThisRecord.fecha),
                          tramite: Text(ThisRecord.tramite),
                          nivel: Text(ThisRecord.nivel),
                          tipo: Text(ThisRecord.tipo),
                          mensaje: Text(ThisRecord.mensaje)
                      }
                  )
              );
              // Aumentar el log actual
              Patch(
                  colMensajeLog,
                  Defaults(colMensajeLog),
                  {
                      fecha: Text(
                          Now(),
                          TablaConfiguracion.FormatoFechaHora
                      ),
                      tramite: var_NombreTramite.Value,
                      nivel: varAlumno.Nivel,
                      tipo: If(IsBlank(var_ErrorInsertarSolicitud), First(TablaConfiguracion.tipoAlerta).Value, Last(TablaConfiguracion.tipoAlerta).Value), // "VALIDACIÓN" o "ERROR"; 
                      mensaje: varErrorMensaje & If(!IsBlank(var_ErrorInsertarSolicitud)," - " & Last(var_ErrorInsertarSolicitud).Column & " - " & Last(var_ErrorInsertarSolicitud).Message) 
                  }
              );
              // Guardar datos en formato json
              Set(
                  varJsonLogUpdate,
                  JSON(colMensajeLog)
              );
              // Enviar los datos a la lista de logs
              If(
                  IsBlank(
                      LookUp(
                          Var_upc_Log,
                          codigoUsuario = varCodigoUsuario
                      )
                  ),
                  Patch(
                      Var_upc_Log,
                      Defaults(Var_upc_Log),
                      {
                          fecha: Text(Now(), "mm/dd/yyyy"),
                          codigoUsuario: varCodigoUsuario,
                          mensaje: varJsonLogUpdate
                      }
                  )
                  ,
                  Patch(
                      Var_upc_Log, 
                      LookUp(Var_upc_Log, codigoUsuario = varCodigoUsuario), 
                      {
                          mensaje: varJsonLogUpdate
                      }
                  )
              );
              //Fin resigrar error

              Set(varErrorMensaje,"");
              Set(varModalError,
                  false
              );
              ""
