            HoverColor: =RGBA(255, 255, 255, 1)
            HoverFill: =ColorFade(RGBA(164, 38, 44, 1), -20%)
            OnSelect: "=Set(\n    varValidaContinua,\n    true\n);\nSet(\n    varValidaCampoRegistro,\n    false\n);\n\n//empieza validaciones\nIf(\n    varValidaContinua,\n    If(\n        IsBlank(dpTipoReclamo.Selected),\n        Set(\n            varValidaContinua,\n            false\n        );\n        Set(\n            varErrorMensaje,\n            LookUp(colGlosasValidacionesRequeridas,codigoGlosa = TablaGlosas.codigoGlosaValidacionTipoReclamo1,mensajeGlosa)\n        );\n        Set(\n            varModalError,\n            true\n        ),\n        Set(\n            varValidaContinua,\n            true\n        )\n    )\n);\n\nIf(\n    varValidaContinua,\n    If(\n        dpTipoReclamo.Selected.codigoTipoReclamo = TablaConfiguracion.codTipoReclamo1, //ERROR DE SUMA\n        If(\n            IsBlank(txtErrorSuma.Text),\n            Set(\n                varErrorMensaje,\n                LookUp(colGlosasValidacionesRequeridas,codigoGlosa = TablaGlosas.codigoGlosaValidacionTipoReclamo2,mensajeGlosa)\n            );\n            Set(\n                varModalError,\n                true\n            );\n            Set(\n                varValidaContinua,\n                false\n            );\n            Set(\n                varValidaCampoRegistro,\n                false\n            );\n            \n            ,            \n            If(\n                CountRows(Filter(colCaracteresEspeciales As t,  t.Value in txtErrorSuma.Text)) > 0,\n                Set(\n                    varErrorMensaje,\n                    LookUp(colGlosasValidacionesRequeridas,codigoGlosa = TablaGlosas.codigoGlosaValidacionTipoReclamo3,mensajeGlosa)\n                );\n                Set(\n                varModalError,\n                    true\n                );\n                Set(\n                    varValidaContinua,\n                    false\n                );\n                Set(\n                    varValidaCampoRegistro,\n                    false\n                );\n                \n                ,                          \n                If(\n                    !(Value(txtErrorSuma.Text) > TablaConfiguracion.valorNotaMin && Value(txtErrorSuma.Text) <= TablaConfiguracion.valorNotaMax),                    \n                    Set(\n                        varErrorMensaje,\n                        LookUp(colGlosasValidacionesRequeridas,codigoGlosa = TablaGlosas.codigoGlosaValidacionTipoReclamo4,mensajeGlosa)\n                    );\n                    Set(\n                        varModalError,\n                        true\n                    );\n                    Set(\n                        varValidaContinua,\n                        false\n                    );\n                    Set(\n                        varValidaCampoRegistro,\n                        false\n                    );\n                    \n                    ,\n                    Set(\n                        varValidaContinua,\n                        true\n                    );\n                    Set(\n                        varValidaCampoRegistro,\n                        true\n                    )                        \n                )\n\n            )\n        )\n    )\n);\n\nIf(\n    varValidaContinua,\n    If(\n        dpTipoReclamo.Selected.codigoTipoReclamo = TablaConfiguracion.codTipoReclamo2, //ERROR DE DIGITACIÓN\n        If(\n            IsBlank(txtErrorDigitacion.Text),\n            Set(\n                varErrorMensaje,\n                LookUp(colGlosasValidacionesRequeridas,codigoGlosa = TablaGlosas.codigoGlosaValidacionTipoReclamo5,mensajeGlosa)\n            );\n            Set(\n                varModalError,\n                true\n            ),\n            If(\n                CountRows(Filter(colCaracteresEspeciales As t,  t.Value in txtErrorDigitacion.Text)) > 0,\n                Set(\n                    varErrorMensaje,\n                    LookUp(colGlosasValidacionesRequeridas,codigoGlosa = TablaGlosas.codigoGlosaValidacionTipoReclamo3,mensajeGlosa)\n                );\n                Set(\n                    varModalError,\n                    true\n                ),\n                If(\n                    !(Value(txtErrorDigitacion.Text) > TablaConfiguracion.valorNotaMin && Value(txtErrorDigitacion.Text) <= TablaConfiguracion.valorNotaMax),\n                    Set(\n                        varErrorMensaje,\n                        LookUp(colGlosasValidacionesRequeridas,codigoGlosa = TablaGlosas.codigoGlosaValidacionTipoReclamo4,mensajeGlosa)\n                    );\n                    Set(\n                        varModalError,\n                        true\n                    )\n                    ,\n                    Set(\n                        varValidaCampoRegistro,\n                        true\n                    )\n                )\n            )\n        )\n    )\n);\n\n\nIf(\n    varValidaContinua,\n    If(\n        dpTipoReclamo.Selected.codigoTipoReclamo = TablaConfiguracion.codTipoReclamo3, //NO SE CONSIDERÓ EL TOTAL DE RESPUESTAS\n        If(\n            CountRows(colPreguntas) = 0,\n            Set(\n                varErrorMensaje,\n                LookUp(colGlosasValidacionesRequeridas,codigoGlosa = TablaGlosas.codigoGlosaValidacionTipoReclamo6,mensajeGlosa)\n            );\n            Set(\n                varModalError,\n                true\n            ),\n            Set(\n                varValidaCampoRegistro,\n                true\n            )\n        )\n    )\n);\n\nIf(\n    varValidaContinua,\n    If(\n        dpTipoReclamo.Selected.codigoTipoReclamo = TablaConfiguracion.codTipoReclamo4, //PREGUNTA NO CORREGIDA\n        If(\n            CountRows(colPreguntas) = 0,\n            Set(\n                varErrorMensaje,\n                LookUp(colGlosasValidacionesRequeridas,codigoGlosa = TablaGlosas.codigoGlosaValidacionTipoReclamo6,mensajeGlosa)                \n            );\n            Set(\n                varModalError,\n                true\n            ),\n            Set(\n                varValidaCampoRegistro,\n                true\n            )\n        )\n    )\n);\n\nIf(\n    varValidaContinua,\n    If(\n        dpTipoReclamo.Selected.codigoTipoReclamo = TablaConfiguracion.codTipoReclamo5, //ERROR EN LA CLAVE DE RESPUESTA\n        If(\n            CountRows(colPreguntas) = 0,\n            Set(\n                varErrorMensaje,\n                LookUp(colGlosasValidacionesRequeridas,codigoGlosa = TablaGlosas.codigoGlosaValidacionTipoReclamo6,mensajeGlosa)\n            );\n            Set(\n                varModalError,\n                true\n            ),\n            Set(\n                varValidaCampoRegistro,\n                true\n            )\n        )\n    )\n);\n\nIf(\n    varValidaContinua,\n    If(\n        dpTipoReclamo.Selected.codigoTipoReclamo = TablaConfiguracion.codTipoReclamo6, //PROBLEMAS CON EL BLACKBOARD\n        If(\n            CountRows(colPreguntasProblemas) = 0,\n            Set(\n                varErrorMensaje,\n                LookUp(colGlosasValidacionesRequeridas,codigoGlosa = TablaGlosas.codigoGlosaValidacionTipoReclamo7,mensajeGlosa)\n            );\n            Set(\n                varModalError,\n                true\n            ),\n            Set(\n                varValidaCampoRegistro,\n                true\n            )\n        )\n    )\n);\n\nIf(\n    varValidaContinua,\n    If(\n        dpTipoReclamo.Selected.codigoTipoReclamo = TablaConfiguracion.codTipoReclamo7, //NO SE CONSIDERÓ MI NOMBRE EN LA EVALUACIÓN O TRABAJO\n        If(\n            IsBlank(txtNoConsidero1.Text) || IsBlank(txtNoConsidero2.Text),\n            Set(\n                varErrorMensaje,\n                LookUp(colGlosasValidacionesRequeridas,codigoGlosa = TablaGlosas.codigoGlosaValidacionTipoReclamo13,mensajeGlosa)\n            );\n            Set(\n                varModalError,\n                true\n            ),\n            If(\n                CountRows(Filter(colCaracteresEspecialesAux As t,  t.Value in txtNoConsidero2.Text)) > 0,\n                Set(\n                    varErrorMensaje,\n                    LookUp(colGlosasValidacionesRequeridas,codigoGlosa = TablaGlosas.codigoGlosaValidacionTipoReclamo8,mensajeGlosa)\n                );\n                Set(\n                    varModalError,\n                    true\n                ),\n\n                If(\n                    !(Value(txtNoConsidero1.Text) > TablaConfiguracion.valorNotaMin && Value(txtNoConsidero1.Text) <= TablaConfiguracion.valorNotaMax),\n                    Set(\n                        varErrorMensaje,\n                        LookUp(colGlosasValidacionesRequeridas,codigoGlosa = TablaGlosas.codigoGlosaValidacionTipoReclamo4,mensajeGlosa)                        \n                    );\n                    Set(\n                        varModalError,\n                        true\n                    )\n                    ,\n                    Set(\n                        varValidaCampoRegistro,\n                        true\n                    )\n                )                \n            )\n        )\n    )\n);\n\nIf(\n    varValidaContinua,\n    If(\n        dpTipoReclamo.Selected.codigoTipoReclamo = TablaConfiguracion.codTipoReclamo8, //ERROR EN ASIGNACIÓN DE NOTA (NR)\n        Set(\n            varValidaCampoRegistro,\n            true\n        )\n    )\n);\n\nIf(\n    varValidaCampoRegistro,\n    Set(\n        varModalConfirmacion,\n        true\n    )\n    \n)"
