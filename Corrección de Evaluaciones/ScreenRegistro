            - dpAsignatura:
                Control: Classic/DropDown@2.3.1
                Properties:
                  AllowEmptySelection: =true
                  BorderColor: =Self.ChevronBackground
                  ChevronBackground: =varColorAzulFigma2
                  ChevronFill: =RGBA(255, 255, 255, 1)
                  ChevronHoverBackground: =//ColorFade(RGBA(164; 38; 44; 1); -20%)
                  ChevronHoverFill: =RGBA(255, 255, 255, 1)
                  Default: =
                  Font: =Font.'Open Sans Condensed'
                  Height: =30
                  HoverColor: =RGBA(255, 255, 255, 1)
                  HoverFill: =varColorAzulFigma2
                  Items: |-
                    =If(varAlumno.modalidadEstudio = TablaConfiguracion.valorModalidadEPE,
                        Filter(colDetalleMatricula, partePeriodocodigo in colVigenciasActivas.modulo),
                        colDetalleMatricula
                    )
                  Items.Value: =DisplayName
                  OnChange: "=//limpiar seccion de reclamo\nReset(dpTipoReclamo);    \nReset(txtErrorSuma);\nReset(txtErrorSuma);\nReset(txtErrorDigitacion);\nReset(dpTipoEvaliacion);\nConcurrent(\n    Clear(colPreguntas),\n    Reset(txtPreguntaCorregidaParcialmente)\n);\nConcurrent(\n    Clear(colPreguntas),\n    Reset(txtPreguntaNoCorregida)\n);\nConcurrent(\n    Clear(colPreguntas),\n    Reset(txtPreguntaNoCorregida)\n);\nConcurrent(\n    Reset(dropSubTipoReclamo),\n    Reset(dropActividad),\n    Clear(colPreguntasProblemas)\n);\nConcurrent(\n    Reset(txtNoConsidero1),\n    Reset(txtNoConsidero2)\n);    \n\nSet(var_modalCargaHome,true);\nSet(varModalError, false);\n//Deshabilita el botón ENVIAR SOLICITUD\nSet(\n    varHabilitarEnviarSol,\n    false\n);\n//Deshabilita la lista de tipo de evaluación\nSet(\n    varHabilitarTipoEvaluacionTipoReclamo,\n    false\n);\n//Reiniciamos la coleccion de tipos de evaluacion\nClear(colTIpoEvaluacionCorreccion);\nClear(colTipoEvaluacionConNota);\nReset(dpTipoEvaliacion);\nSet(notaEvaluacion,Blank());\n//Si ha seleccionado un valor diferente al vacío\nIf(IsBlank(dpAsignatura.Selected.DisplayName),\n\n    Clear(colTipoEvaluacionSegunCurso)\n\n    ,//Caso contrario\n\n    //Colección que obtiene los tipos de evaluación inactivos para corrección de evaluaciones\n    Set(colTiposEvaluacionCorreccion,Filter(Var_upc_ConfiguracionTramiteTipoEvaluacion, Estado.Value= \"Activo\" && codigoConfiguracionTramite.Value = varConfiguracionTramite.codigoConfiguracionTramite));\n                    \n    //Colección que obtiene todas las evaluaciones para el curso seleccionado\n    Clear(colTipoEvaluacionSegunCurso);\n    Collect(colTipoEvaluacionSegunCurso,\n        Filter(colAvanceNotas, \n            CodCurso= dpAsignatura.Selected.codCurso\n        )   \n    );\n    //Se filtran las evaluaciones para considerar solo las permitidas a corrección de evaluaciones\n    \n    ForAll(colTipoEvaluacionSegunCurso As evalCurso,\n        Collect(colTIpoEvaluacionCorreccion,\n            If( CountRows(Filter(colTiposEvaluacionCorreccion, codigoTipoPrueba.Value = Left(evalCurso.CodTipoPrueba,2))) > 0 ,\n                {\n                    CodCurso:evalCurso.CodCurso,\n                    CodTipoPrueba:evalCurso.CodTipoPrueba,\n                    DesCurso:evalCurso.DescCurso,\n                    DisplayName:evalCurso.DisplayName,\n                    Id:evalCurso.Id,\n                    Nota:evalCurso.Nota\n                }  \n            )\n        )\n    );\n\n    //REG031-Validar Sancion Disciplinaria por Curso\n    ClearCollect(\n        col_detSancionesWS,\n        ForAll(\n            Table(ParseJSON(varAlumno.jsonSanciones).listaSanciones),\n            {\n                codigoPeriodoExpedienteColSanciones: Text(Value.codigoPeriodoExpediente),\n                codigoMateriaColSanciones: Text(Value.codigoMateria),\n                numeroCursoColSanciones: Text(Value.numeroCurso),\n                codigoTipoSancionColSanciones: Text(Value.codigoTipoSancion),\n                Concat:Text(Value.codigoMateria)&Text(Value.numeroCurso)\n            }\n        )\n    );\n\n    Clear(col_detSancionesFiltradas);\n    ForAll(col_detSancionesWS As sancionAlumno,\n        If(sancionAlumno.codigoTipoSancionColSanciones in Distinct(colTiposSancionesTramiteCurso, codigoTipoSancion.Value) && sancionAlumno.codigoMateriaColSanciones = dpAsignatura.Selected.materiaCodigo &&\n            sancionAlumno.numeroCursoColSanciones = dpAsignatura.Selected.numeroCurso ,                \n            Collect(col_detSancionesFiltradas,\n                sancionAlumno\n            )\n        )            \n    );\n\n    //REG032-Validar Posible Sancion Disciplinaria por Curso\n    ClearCollect(\n        col_detPosiblesSanciones,\n        ForAll(\n            Table(ParseJSON(varAlumno.jsonPosibleSancion).listaPosibleSancion),\n            {\n                codigoPeriodoExpedienteColPosibleSanciones: Text(Value.codigoPeriodoExpediente),\n                codigoMateriaColPosibleSanciones: Text(Value.codigoMateria),\n                numeroCursoColPosibleSanciones: Text(Value.numeroCurso),\n                Concat:Text(Value.codigoMateria)&Text(Value.numeroCurso)\n            }\n        )\n    );\n    ClearCollect(\n        col_detPosiblesSancionesFiltradas,\n        Filter(\n            col_detPosiblesSanciones,\n            Text(codigoPeriodoExpedienteColPosibleSanciones) = Text(varAlumno.Periodo),\n            codigoMateriaColPosibleSanciones = dpAsignatura.Selected.materiaCodigo,\n            numeroCursoColPosibleSanciones = dpAsignatura.Selected.numeroCurso\n        )\n    );\n\n\n    //Obtener valores de reglas ---------------------------------\n    Set(var_Reglamento,LookUp(Var_upc_ConfiguracionTramite,codigoConfiguracionTramite=var_confTRam));\n\n    //Actualizamos la lista de reglamento Reglas \n    Refresh(Var_upc_ReglamentoReglas);\n\n    //valores de evaluacion\n\n    //Establecemos la colección de reglas a validar\n    ClearCollect(colReglamentos,\n        Filter(Var_upc_ReglamentoReglas,\n            codigoReglamento.Value=var_Reglamento.codigoReglamento.Value\n            && estado.Value= TablaConfiguracion.filtroEstadoRegla\n            && (codigoRegla.Value=\"REG002\"\n                || codigoRegla.Value=\"REG031\"\n                || codigoRegla.Value=\"REG032\"\n            )\n        ) \n    );\n\n    //Limpiamos la colección de cumplimientos de reglas \n    Clear(colCumpleRegla);\n\n    //Recorremos la colección de reglamentos por regla \n    //luego recorremos por cada tipo de evaluación \n    \n    //REG031\n    Set(\n        valRegla2,\n        CountRows(col_detSancionesFiltradas)\n    );\n    //REG032\n    Set(\n        valRegla3,\n        CountRows(col_detPosiblesSancionesFiltradas)\n    );\n    \n    ForAll(\n        colReglamentos,\n        Switch(\n            ThisRecord.codigoRegla.Value,\n            //regla1\n            \"REG002\",\n            Switch(\n                ThisRecord.codigoTipoEvaluacion.Value,\n                \"TIEV001\",\n                Collect(\n                    colCumpleRegla,\n                    {\n                        Codigo: ThisRecord.codigoRegla.Value,\n                        Cumple: If(\n                            Text(dpAsignatura.Selected.estadoInscripcionCodigo) = Text(ThisRecord.valor),\n                            \"No\",\n                            \"Si\"\n                        ),\n                        Glosa: ThisRecord.codigoGlosa.Value,\n                        Valor: ThisRecord.valor\n                    }\n                ),\n                \"TIEV002\",\n                Collect(\n                    colCumpleRegla,\n                    {\n                        Codigo: ThisRecord.codigoRegla.Value,\n                        Cumple: If(\n                            Value(dpAsignatura.Selected.estadoInscripcionCodigo) > Value(ThisRecord.valor),\n                            \"No\",\n                            \"Si\"\n                        ),\n                        Glosa: ThisRecord.codigoGlosa.Value,\n                        Valor: ThisRecord.valor\n                    }\n                ),\n                \"TIEV003\",\n                Collect(\n                    colCumpleRegla,\n                    {\n                        Codigo: ThisRecord.codigoRegla.Value,\n                        Cumple: If(\n                            Value(dpAsignatura.Selected.estadoInscripcionCodigo) >= Value(ThisRecord.valor),\n                            \"No\",\n                            \"Si\"\n                        ),\n                        Glosa: ThisRecord.codigoGlosa.Value,\n                        Valor: ThisRecord.valor\n                    }\n                ),\n                \"TIEV004\",\n                Collect(\n                    colCumpleRegla,\n                    {\n                        Codigo: ThisRecord.codigoRegla.Value,\n                        Cumple: If(\n   